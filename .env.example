# ===== 火山引擎 方舟（Ark）LLM =====
# Doubao-Seed-Evolving，用于主张抽取 / agent 核查推理 / 长辈卡片文案
ARK_API_KEY=your_ark_api_key
# 可选：覆盖默认端点与模型（默认走 ark plan 端点 + ark-code-latest 路由）
# ARK_API_BASE=https://ark.cn-beijing.volces.com/api/v3
# ARK_MODEL=doubao-seed-evolving

# ===== 火山引擎 豆包联网搜索（Search Infinity）=====
# 用于 agent 的联网深度检索
# 开通：https://console.volcengine.com/search-infinity/api-key
WEB_SEARCH_API_KEY=your_web_search_api_key
